from typing import Any, override

class SpecializedTurboConfigFlow(ConfigFlow, domain=DOMAIN):
    VERSION: int
    _discovery_info: BluetoothServiceInfoBleak | None
    _discovered_devices: dict[str, BluetoothServiceInfoBleak]
    _address: str | None
    _title: str
    _advertisement: BikeAdvertisement | None
    _bike_info: BikeInfo | None
    _target_entry_id: str | None
    def __init__(self) -> None: ...
    async def _async_test_connection(self) -> bool: ...
    async def _async_validate_encrypted_connection(self, wrapped_key: str) -> bool: ...
    async def _async_validate_connection(self, wrapped_key: str | None = None) -> bool: ...
    @override
    async def async_step_bluetooth(self, discovery_info: BluetoothServiceInfoBleak) -> ConfigFlowResult: ...
    async def async_step_bluetooth_confirm(self, user_input: dict[str, Any] | None = None) -> ConfigFlowResult: ...
    @override
    async def async_step_user(self, user_input: dict[str, Any] | None = None) -> ConfigFlowResult: ...
    async def _async_device_form(self, step_id: str, user_input: dict[str, Any] | None, *, include_address: bool) -> ConfigFlowResult: ...
    async def async_step_key_source(self, _user_input: dict[str, Any] | None = None) -> ConfigFlowResult: ...
    async def async_step_account(self, user_input: dict[str, Any] | None = None) -> ConfigFlowResult: ...
    async def async_step_manual_key(self, user_input: dict[str, Any] | None = None) -> ConfigFlowResult: ...
    async def async_step_reauth(self, entry_data: Mapping[str, Any]) -> ConfigFlowResult: ...
    async def async_step_reconfigure(self, user_input: dict[str, Any] | None = None) -> ConfigFlowResult: ...
    async def _async_fetch_account_key(self, email: str, password: str) -> str: ...
    def _set_device(self, info: BluetoothServiceInfoBleak) -> None: ...
    @property
    def _requires_encryption(self) -> bool: ...
    def _device_schema(self, *, include_address: bool) -> vol.Schema: ...
    def _create_or_update_entry(self, key_data: dict[str, Any]) -> ConfigFlowResult: ...

def _is_specialized_service_info(info: BluetoothServiceInfoBleak) -> bool: ...
