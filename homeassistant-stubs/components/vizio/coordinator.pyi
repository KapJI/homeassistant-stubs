def _records_from_storage(data: list[dict[str, Any]]) -> tuple[AppRecord, ...] | None: ...

@dataclass(frozen=True)
class VizioRuntimeData:
    device_coordinator: VizioDeviceCoordinator

@dataclass(frozen=True)
class VizioDeviceData:
    is_on: bool
    audio_settings: dict[str, SettingInfo] | None = ...
    volume: int | None = ...
    is_muted: bool | None = ...
    sound_mode_list: list[str] | None = ...
    current_input: str | None = ...
    input_list: list[InputInfo] | None = ...
    current_app_config: AppConfig | None = ...
    battery_level: int | None = ...
    charging_status: ChargingStatus | None = ...

class VizioDeviceCoordinator(DataUpdateCoordinator[VizioDeviceData]):
    config_entry: VizioConfigEntry
    device: Incomplete
    _use_state_extended: bool
    def __init__(self, hass: HomeAssistant, config_entry: VizioConfigEntry, device: Vizio) -> None: ...
    @override
    async def _async_setup(self) -> None: ...
    def _update_failed(self) -> UpdateFailed: ...
    @override
    async def _async_update_data(self) -> VizioDeviceData: ...

class VizioAppsDataUpdateCoordinator(DataUpdateCoordinator[tuple[AppRecord, ...]]):
    fail_count: int
    fail_threshold: int
    store: Incomplete
    availability: tuple[AppAvailability, ...]
    def __init__(self, hass: HomeAssistant, store: Store[list[dict[str, Any]]]) -> None: ...
    data: Incomplete
