class EntityTriggerBase(Trigger):
    _domain_specs: Mapping[str, DomainSpec]
    _excluded_states: Final[frozenset[str]]
    _excluded_from_states: ClassVar[frozenset[str]]
    _schema: probatio.Schema
    _primary_entities_only: ClassVar[bool]
    @override
    @classmethod
    async def async_validate_config(cls, hass: HomeAssistant, config: ConfigType) -> ConfigType: ...
    _options: Incomplete
    _duration: timedelta | None
    _target: Incomplete
    def __init__(self, hass: HomeAssistant, config: TriggerConfig) -> None: ...
    def entity_filter(self, entities: set[str]) -> set[str]: ...
    def _get_tracked_value(self, state: State) -> Any: ...
    def is_valid_transition(self, from_state: State, to_state: State) -> bool: ...
    def is_valid_state(self, state: State, report_not_triggered: NotTriggeredReasonReporter) -> bool: ...
    def _should_include(self, state: State) -> bool: ...
    def count_matches(self, entity_ids: Iterable[str], states: Mapping[str, State | None] | None = None) -> tuple[int, int]: ...
    @callback
    def _cancel_invalidated_timers(self, behavior: str, pending_timers: dict[str, CALLBACK_TYPE], target_state_change_data: TargetStateChangedData) -> None: ...
    def _combined_state_still_valid(self, behavior: str, entity_ids: Iterable[str], states: Mapping[str, State | None]) -> bool: ...
    @override
    async def async_attach_runner(self, run_action: TriggerActionRunner, did_not_trigger: TriggerNotTriggeredReporter | None = None) -> CALLBACK_TYPE: ...

